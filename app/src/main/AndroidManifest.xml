<?xml version="1.0" encoding="utf-8"?>
<!--
    ChronoX AndroidManifest.xml

    Permissions declared:
    - POST_NOTIFICATIONS    : Required on API 33+ for alarm/timer notifications
    - SCHEDULE_EXACT_ALARM  : Allows setting exact alarms (API 31+ requires user permission)
    - USE_EXACT_ALARM       : Alternative permission for exact alarms on API 33+ (pre-granted)
    - RECEIVE_BOOT_COMPLETED: Required to reschedule alarms after device reboot
    - VIBRATE               : Required for alarm/timer vibration

    Components:
    - MainActivity          : Single host activity (singleTop prevents re-launch stacking)
    - AlarmReceiver         : BroadcastReceiver that fires when an alarm time arrives
    - BootReceiver          : BroadcastReceiver that reschedules alarms after device restart
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================================================
         PERMISSIONS
         ========================================================= -->

    <!--
        POST_NOTIFICATIONS: Required on API 33 (Android 13) and newer.
        Without it, alarm and timer notifications will not appear on API 33+.
        We request this permission at runtime.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        SCHEDULE_EXACT_ALARM: Allows scheduling alarms that fire at precise times.
        On API 31–32: Granted by default unless revoked by user in Settings.
        On API 33+: Users must explicitly grant in Settings > Special app access.
        The app must check canScheduleExactAlarms() before using setExactAndAllowWhileIdle().
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
        USE_EXACT_ALARM: API 33+ alternative to SCHEDULE_EXACT_ALARM.
        Granted automatically without user action for alarm-clock apps.
        Declared together with SCHEDULE_EXACT_ALARM for broad compatibility.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
        RECEIVE_BOOT_COMPLETED: Needed for BootReceiver.
        Android clears all AlarmManager alarms on device restart.
        This permission lets us re-register saved alarms after reboot.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        VIBRATE: Allows the alarm and countdown timer to vibrate the device.
        No runtime request needed — normal permission, auto-granted at install.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Required for alarm apps to display their ringing screen over the lock screen on Android 14+. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- =========================================================
         APPLICATION
         ========================================================= -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <!-- =====================================================
             MAIN ACTIVITY
             singleTop: prevents re-creating when user taps launcher icon while app is running.
             ===================================================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alarm.AlarmRingingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme" />

        <!-- =====================================================
             ALARM RECEIVER
             Fired by AlarmManager when a scheduled alarm time arrives.
             exported=false: internal use only — no external apps should trigger it.
             ===================================================== -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Persistent looping sound and Stop Sound action for countdown completion. -->
        <service
            android:name=".timer.TimerAlertService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Countdown deadline callback. Restored from the saved deadline on app launch/reboot. -->
        <receiver
            android:name=".timer.TimerFinishedReceiver"
            android:exported="false" />

        <!-- =====================================================
             BOOT RECEIVER
             Fired after device restart to reschedule all saved alarms.
             exported=true: required for the system to deliver BOOT_COMPLETED.
             ===================================================== -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Also handle quick boot on some devices -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
