<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppBackground">

    <com.example.chronox.common.MatrixBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- PLAYER 2 PANEL (Rotated) -->
        <RelativeLayout
            android:id="@+id/panel_player2"
            android:layout_margin="16dp"
            android:background="@drawable/bg_chess_panel_inactive"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:rotation="180"
            android:clickable="true"
            android:focusable="true">
            
            <TextView
                android:id="@+id/tv_player2_moves_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="24dp"
                android:text="Moves: 0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAppTextSecondary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/tv_player2_name"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                                        android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_chess_editable_name"
                    android:padding="8dp"
                    android:hint="Enter your name"
                    android:textColorHint="?attr/colorAppTextSecondary"
                    android:contentDescription="Edit player name"/>
                    
                <TextView
                    android:id="@+id/tv_player2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="80sp"
                    android:textColor="?attr/colorPlayer2"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="10:00" />
                    
                <TextView
                    android:id="@+id/tv_player2_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chess_waiting"
                    android:textSize="14sp"
                    android:textColor="?attr/colorAppTextSecondary"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- CENTER CONTROL BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorAppSurface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chess_play_pause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    app:icon="@drawable/ic_play"
                    app:iconSize="24dp"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorAppTextPrimary"
                    android:backgroundTint="?attr/colorAppSurfaceSecondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="28dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/btn_press"
                    android:contentDescription="Start chess timer" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chess_end"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    app:icon="@drawable/ic_end_game"
                    app:iconSize="24dp"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorAppTextPrimary"
                    android:backgroundTint="?attr/colorAppSurfaceSecondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="28dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/btn_press"
                    android:contentDescription="End chess game" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chess_record"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    app:icon="@drawable/ic_history"
                    app:iconSize="24dp"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorAppTextPrimary"
                    android:backgroundTint="?attr/colorAppSurfaceSecondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="28dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/btn_press"
                    android:contentDescription="Open chess game records" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chess_settings"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="24dp"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorAppTextPrimary"
                    android:backgroundTint="?attr/colorAppSurfaceSecondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="28dp"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/btn_press"
                    android:contentDescription="Chess timer settings" />
            </FrameLayout>
        </LinearLayout>

        <!-- PLAYER 1 PANEL -->
        <RelativeLayout
            android:id="@+id/panel_player1"
            android:layout_margin="16dp"
            android:background="@drawable/bg_chess_panel_inactive"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">
            
            <TextView
                android:id="@+id/tv_player1_moves_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="24dp"
                android:text="Moves: 0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAppTextSecondary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/tv_player1_name"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                                        android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_chess_editable_name"
                    android:padding="8dp"
                    android:hint="Enter your name"
                    android:textColorHint="?attr/colorAppTextSecondary"
                    android:contentDescription="Edit player name"/>
                    
                <TextView
                    android:id="@+id/tv_player1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="80sp"
                    android:textColor="?attr/colorPlayer1"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="10:00" />
                    
                <TextView
                    android:id="@+id/tv_player1_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chess_waiting"
                    android:textSize="14sp"
                    android:textColor="?attr/colorAppTextSecondary"/>
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</FrameLayout>


