<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_timer_container.xml — Hosts the two timer features as tabs.

    Structure:
    - TabLayout — shows two tabs: Countdown | Stopwatch
    - ViewPager2 — swipeable fragment pages, one per tab
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorAppBackground">

    <!-- Tab bar: Countdown / Stopwatch -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        style="@style/Widget.ChronoX.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:elevation="4dp" />

    <!-- Swipeable page content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

