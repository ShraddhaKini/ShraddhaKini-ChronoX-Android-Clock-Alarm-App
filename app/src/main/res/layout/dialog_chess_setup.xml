<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorAppSurface"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_setup_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Setup Game"
        android:textSize="20sp"
        android:textColor="?attr/colorAppTextPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select time per player"
        android:textSize="14sp"
        android:textColor="?attr/colorAppTextSecondary"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.chip.ChipGroup app:singleSelection="true"
        android:id="@+id/cg_time_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Custom time inputs -->
    <LinearLayout
        android:id="@+id/ll_custom_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="16dp">
        
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ChronoX.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="Minutes">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_custom_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ChronoX.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="Increment (sec)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_custom_increment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="0" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

</LinearLayout>
